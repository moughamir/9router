    expect([200, 400, 401, 402, 500]).toContain(res.status);

    if (!LOG_FILE) return;
    await new Promise(r => setTimeout(r, 500));
    const { text } = readLogSince(offset);
    const matches = [...text.matchAll(/\[RTK\] saved (\d+)B \/ (\d+)B \([\d.]+%\) via \[([\w,-]+)\] hits=(\d+)/g)];
