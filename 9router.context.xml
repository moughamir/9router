```bash
cp .env.example .env
bun install
PORT=20128 NEXT_PUBLIC_BASE_URL=http://localhost:20128 bun run dev
```

生产模式：

```bash
bun run build
PORT=20128 HOSTNAME=0.0.0.0 NEXT_PUBLIC_BASE_URL=http://localhost:20128 bun run start
```

