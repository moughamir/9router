/**
 * xAI (Grok) OAuth Configuration
 *
 * Source of truth: router-for-me/CLIProxyAPI internal/auth/xai/types.go
 * Mirrors the upstream Go constants 1:1.
 */
import { PROVIDERS } from "open-sse/providers/index.js";

